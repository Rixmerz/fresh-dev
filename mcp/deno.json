{
  "name": "@rixmerz/fresh-mcp",
  "version": "0.1.0",
  "exports": {
    ".": "./main.ts",
    "./cli": "./cli.ts"
  },
  "tasks": {
    "mcp": "deno run --allow-read --allow-env --allow-run=deno,git --allow-write main.ts --stdio",
    "cli": "deno run --allow-read --allow-env --allow-run=deno,git --allow-write cli.ts",
    "check": "deno fmt --check && deno lint && deno check main.ts cli.ts",
    "test": "deno test --allow-read --allow-env --allow-run=deno,git --allow-write"
  },
  "imports": {
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.22.0",
    "zod": "npm:zod@^3.25.0",
    "typescript": "npm:typescript@^5.9.0",
    "@std/path": "jsr:@std/path@^1.1.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "dom"]
  },
  "lint": { "rules": { "tags": ["recommended"] } },
  "fmt": { "lineWidth": 100, "semiColons": true, "singleQuote": false },
  "exclude": ["../fixtures"]
}
